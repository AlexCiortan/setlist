#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Setlist trunk audit as a git pre-push hook. STAMPED AND LIVE since edition v1.7:
# scripts/stamp.sh and scripts/refresh-instance.sh both install it to
# .githooks/pre-push and set core.hooksPath, so it runs on every push without
# anyone adopting it.
#
# This header said the opposite until 2026-08-03. It read "OPT-IN: this file is
# NOT stamped into an instance ... and nothing installs it for you", and gave
# copy instructions targeting .git/hooks/pre-push. Both halves were wrong and the
# second was actively harmful: .git/hooks is NOT cloned, which is the whole reason
# the stamp uses a tracked .githooks/ directory plus core.hooksPath, so following
# these instructions produced a hook that protects exactly one working copy and
# looks installed. A shipped file's own documentation contradicting the shipped
# stamp is this repository's signature defect; it was filed during the v1.7 gate's
# Phase 1, missed by the Phase 4 pass that edited this very layer, and found
# independently by the 1.1.0 adversarial review.
#
# Why opt-in, and why a git hook rather than a Claude Code hook. The three
# PreToolUse gates decide by parsing a shell command before it runs, and a
# shell command can compute its own arguments, so no parser can be correct
# about what a command will do. This asks a question that needs no parsing:
# does the trunk's HISTORY show every piece of feature code arriving through a
# closed spec? It therefore catches what the parsers miss by construction,
# including work that reached the trunk through a renamed branch, a cherry-pick,
# a tag, or your forge's merge button, which no local Claude Code hook can see
# at all. It does NOT see through merge topology built to hide the work: the
# chained-merge and octopus checks were removed on 2026-08-07 because neither
# could tell a crafted merge apart from `git pull` on a shared trunk, and both
# routes are named in Known limitations.
#
# It runs at push, which is the last moment the history is still private.
#
# This paragraph used to say the hook was "the OPT-IN half of the mechanism"
# and that making it part of the protocol "waits for the v1.7 cut (backlog item
# 28)". The 2026-08-03 correction above fixed the header and left this standing
# four lines below it, so the file contradicted itself in the same comment
# block; the 1.1.0 adversarial review filed the header half and this half survived it.
# v1.7 IS the cut. Item 28 landed, this hook is stamped by default, and the
# enforcement boundary is described in the edition text.
#
# TWO ESCAPES, AND THEY ARE NOT THE SAME ESCAPE (KL2, and PD11's advice strings).
#
#   SETLIST_SKIP_TRUNK_AUDIT=1   skips the TRUNK AUDIT only. The content scan
#                                still runs, and a secret-carrying push is still
#                                refused.
#   SETLIST_SKIP_HOOKS=1         skips this hook ENTIRELY, exactly as it skips
#                                pre-commit. The whole-hook escape.
#
# Until 2026-08-26 there was one variable and it did both jobs, because it was
# written when this hook did one job. When the content scan was added to
# pre-push, the audit's escape silently became the scan's escape too: an
# operator skipping a known-noisy audit ALSO turned off the secret scan, with
# nothing on stderr saying so, and the scan is the half that protects a remote
# rather than a branch policy. The name says "trunk audit"; it now skips the
# trunk audit.
#
# PD11's half is the other end of the same defect. Two refusal messages in this
# file advised `SETLIST_SKIP_HOOKS=1`, which this hook did not read, so the
# advice was INERT: an operator following it exactly got the same refusal again.
# The variable is honoured here now rather than the advice deleted, because the
# advice was right about what an operator needs and wrong only about whether it
# worked, and pre-commit already documents this spelling as THE deliberate
# whole-hook exception.

set -u

# THE CHAIN RUNNER'S ENTRY (spec 0173, item 2). One EXIT trap, set before anything
# can exit, so whatever this hook decides (a pass, a refusal, the SETLIST_SKIP_HOOKS
# escape), a hook manager recorded as "hooks_chain" in .claude/sdd.json then runs
# its hook of the same name with the same arguments, and the exit status carries
# both verdicts (slh_chain_displaced in the library says how). The library is
# sourced here when this hook exited before sourcing it. This hook's private copy of
# a pushed commit's configuration is removed here too, on every exit, and only that:
# CFG_TMPD is emptied before the trap is set, so the path it removes is the one
# mktemp gave this process, never one the caller's environment named (spec 0180, F11).
SETLIST_HOOK_ARGS=("$@")
CFG_TMPD=""
setlist_chain_on_exit() {
  local rc=$? lib top
  trap - EXIT
  [ -z "${CFG_TMPD:-}" ] || rm -rf "$CFG_TMPD"
  if ! declare -F slh_chain_displaced >/dev/null; then
    lib="$(dirname "$0")/setlist-hook-lib.sh"
    [ -f "$lib" ] || exit "$rc"
    # shellcheck source=/dev/null
    . "$lib" || exit "$rc"
  fi
  # A library without the chain runner (a mixed generation the refresh's atomic
  # delivery never produces) leaves the hook's own status in charge.
  declare -F slh_chain_displaced >/dev/null || exit "$rc"
  top="$(git rev-parse --show-toplevel 2>/dev/null)" || exit "$rc"
  slh_chain_displaced "$top" "${0##*/}" "$rc" ${SETLIST_HOOK_ARGS[@]+"${SETLIST_HOOK_ARGS[@]}"}
  exit $?
}
trap setlist_chain_on_exit EXIT

if [[ "${SETLIST_SKIP_HOOKS:-}" == "1" ]]; then
  printf 'setlist: pre-push skipped ENTIRELY by SETLIST_SKIP_HOOKS=1 (scan and audit both)\n' >&2
  # fail-open-ok: the DOCUMENTED whole-hook escape hatch, announced on stderr so
  # the bypass is never silent. Same spelling, same meaning, as pre-commit's.
  exit 0
fi

SKIP_AUDIT=0
if [[ "${SETLIST_SKIP_TRUNK_AUDIT:-}" == "1" ]]; then
  printf 'setlist: trunk audit skipped by SETLIST_SKIP_TRUNK_AUDIT=1\n' >&2
  printf 'setlist: the push-time content scan still runs.\n' >&2
  SKIP_AUDIT=1
fi

REPO="$(git rev-parse --show-toplevel 2>/dev/null || printf '.')"

# THE CHECKOUT SWITCH, CLOSED AT PUSH FOR EVERY CHECKOUT THAT STILL HAS THIS HOOK
# (spec 0173, item 1). This line used to be `[[ -f "$REPO/.claude/sdd.json" ]] ||
# exit 0`: a push was governed only when the CHECKED-OUT branch carried the file,
# so the identical push of the identical unclosed merge was refused from main and
# accepted after `git checkout --orphan` (measured, the suite's `sdd switch`). The
# guard's purpose is right, a hooksPath must not govern unrelated work, and the
# question it asked was the wrong one: whether the work being PUSHED is governed is
# a fact about the pushed commits. So the ref lines are read first, and a push is
# governed when the checkout carries the file (today's reading, preferred, every
# existing verdict unchanged) OR a pushed tip does. In the second case the push's
# readers read the FIRST governed tip's configuration (slh_sdd in the library), and
# the trunk audit reads EACH audited tip's own (--config-from that tip; spec 0180,
# fix round 2, the 2.11.0 leg's F7: one configuration chosen for the whole push
# audited a trunk under a sibling branch's roles, and a violating trunk reached the
# remote reading clean). A ref is audited as a trunk when the first governed tip's
# configuration or its own names it, and a trunk tip that carries no .claude/sdd.json
# of its own is ungoverned, as below, and reported unaudited by name rather than read
# clean under another tip's. A push whose tips carry no .claude/sdd.json from a checkout without one
# stays ungoverned: that is unrelated work. What no hook reaches: a checkout of a
# branch that does not carry .githooks/ has no pre-push on disk at all, so git runs
# none (Known limitations, "checkout-switch"); pre-commit and pre-merge-commit keep
# the checked-out reading.
PUSH_LINES="$(cat)"
CFG_FROM=""
if [[ ! -f "$REPO/.claude/sdd.json" ]]; then
  while read -r _l _lo _r _ro; do
    [[ -n "${_r:-}" ]] || continue
    case "$_lo" in *[!0]*) ;; *) continue ;; esac
    if git -C "$REPO" cat-file -e "$_lo:.claude/sdd.json" 2>/dev/null; then CFG_FROM="$_lo"; break; fi
  done <<< "$PUSH_LINES"
  # fail-open-ok: neither the checkout nor any pushed tip carries .claude/sdd.json, so this push is not a framework instance's work; the guard's purpose
  [[ -n "$CFG_FROM" ]] || exit 0
fi

# HISTORY: ruling PP-01 (undated): The audit ships with the plugin.
AUDIT=""
for cand in \
  "${CLAUDE_PLUGIN_ROOT:-}/scripts/trunk-audit.sh" \
  "$REPO/.claude/hooks/trunk-audit.sh" ; do
  [[ -n "$cand" && -f "$cand" ]] && { AUDIT="$cand"; break; }
done
if [[ -z "$AUDIT" ]]; then
  printf 'setlist pre-push: cannot find trunk-audit.sh.\n' >&2
  printf '  Set CLAUDE_PLUGIN_ROOT, or copy the script to .claude/hooks/trunk-audit.sh.\n' >&2
  printf '  Refusing rather than passing: a check that cannot run has not passed.\n' >&2
  exit 1
fi

# HISTORY: ruling PP-02 (plugin 1.1.0): THE STATUS IS CAPTURED FROM THE AUDIT, NOT FROM THE IF-COMPOUND.
LIB=""
for cand in "$(dirname "$0")/setlist-hook-lib.sh" "$REPO/.githooks/setlist-hook-lib.sh"; do
  [[ -f "$cand" ]] && { LIB="$cand"; break; }
done
if [[ -z "$LIB" ]]; then
  printf 'setlist pre-push: cannot find setlist-hook-lib.sh beside this hook.\n' >&2
  printf '  Refusing rather than reading the trunk a second way: two readers of one value\n' >&2
  printf '  is the defect this hook was repaired for.\n' >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$LIB"

# The pushed tip's configuration, materialised ONCE, read by every reader through
# slh_sdd (set only here, after sourcing, which empties it). A copy that cannot be
# made refuses: a push this hook decided is governed is never waved through because
# a workspace was unavailable.
if [[ -n "$CFG_FROM" ]]; then
  CFG_TMPD="$(mktemp -d 2>/dev/null)" || CFG_TMPD=""
  if [[ -z "$CFG_TMPD" ]] || ! git -C "$REPO" show "$CFG_FROM:.claude/sdd.json" > "$CFG_TMPD/sdd.json" 2>/dev/null; then
    printf 'setlist pre-push: the checked-out branch carries no .claude/sdd.json and the pushed commit %s does,
' "$CFG_FROM" >&2
    printf 'but its copy could not be read into a private workspace. Refusing rather than pushing
' >&2
    printf 'governed history ungoverned. Check TMPDIR and the repository.
' >&2
    [[ -z "$CFG_TMPD" ]] || rm -rf "$CFG_TMPD"
    exit 1
  fi
  # shellcheck disable=SC2034  # read by the sourced library through slh_sdd
  SLH_SDD="$CFG_TMPD/sdd.json"
  printf 'setlist pre-push: the checked-out branch carries no .claude/sdd.json; this push is governed by
' >&2
  printf 'the configuration of the commit it pushes (%s).
' "$CFG_FROM" >&2
fi

# HISTORY: ruling PP-03 (plugin v1.7): THE TOOLCHAIN PROBE, WHICH THIS HOOK DID NOT RUN (v1.7 claims audit, R2-3).
slh_require_toolchain || {
  printf '\nsetlist pre-push: the push-time scan cannot run (see above).\n' >&2
  printf 'Refusing the push rather than reporting a clean scan it did not perform.\n' >&2
  exit 1
}

TRUNK_NAME="$(slh_trunk "$REPO")" || {
  printf '\nsetlist pre-push: the recorded trunk could not be reduced to a local branch (see above).\n' >&2
  printf 'Refusing the push: a hook that cannot establish the trunk cannot audit it.\n' >&2
  exit 1
}
[[ -n "$TRUNK_NAME" ]] || { printf 'setlist pre-push: the reduced trunk is empty; refusing.\n' >&2; exit 1; }

# HISTORY: ruling PP-04 (2026-08-07): THE REMOTE'S TRUNK MAY NOT SHARE THE LOCAL NAME (F11).
REMOTE_ARG="${1:-}"

REMOTE_TRUNK=""
REMOTE_UNREACHABLE=0
REMOTE_EMPTY=0
if [[ -n "${1:-}" ]]; then
  REMOTE_TRUNK="$(git -C "$REPO" symbolic-ref --quiet --short "refs/remotes/$1/HEAD" 2>/dev/null || true)" # fail-open-ok: the cache is a fast path only; the live query below is what decides when it is empty
  REMOTE_TRUNK="${REMOTE_TRUNK#$1/}"
  if [[ -z "$REMOTE_TRUNK" ]]; then
    if SYMREF_OUT="$(git -C "$REPO" ls-remote --symref "$1" HEAD 2>/dev/null)"; then
      REMOTE_TRUNK="$(printf '%s\n' "$SYMREF_OUT" | awk '$1 == "ref:" { sub(/^refs\/heads\//, "", $2); print $2; exit }')"
      # HISTORY: ruling PP-05 (undated): No HEAD symref AND no branch refs at all is an EMPTY remote:
      if [[ -z "$REMOTE_TRUNK" && -z "$(git -C "$REPO" ls-remote --heads "$1" 2>/dev/null)" ]]; then
        REMOTE_EMPTY=1
      fi
    else
      REMOTE_UNREACHABLE=1
    fi
  fi
fi

PUSH_REFS=""

# HISTORY: ruling PP-06 (plugin 2.6.0): THE SCAN WALKS THE RANGE PER COMMIT, and the walk lives in the library since.

# HISTORY: ruling PP-07 (undated): TWO CHECKS, TWO SCOPES, AND THEY ARE NOT THE SAME SCOPE (F2, verdict leg).
while read -r _lref _loid rref _roid; do
  [[ -n "${rref:-}" ]] || continue

  # A deletion pushes the all-zero local oid and removes the branch or tag. No
  # history is arriving, so there is nothing to scan and nothing to audit.
  case "$_loid" in *[!0]*) ;; *) continue ;; esac

  # HISTORY: ruling PP-08 (plugin v1.0.0): A TAG PUSH CARRIES HISTORY AND WAS NOT SCANNED AT ALL (SC sub-hole 5).
  case "$rref" in
    refs/tags/*)
      tname="${rref#refs/tags/}"
      # A tag may be annotated, so it is peeled to the commit it names.
      # fail-open-ok: an unpeelable target leaves this empty and the refusal below fires.
      TAG_TIP="$(git -C "$REPO" rev-list -n1 "$_loid" 2>/dev/null || true)"
      if [ -z "$TAG_TIP" ]; then
        slh_refuse "SLH-TAG-UNSCANNABLE" "tag $tname does not resolve to a commit here, so what it publishes cannot be read. Refusing rather than pushing unscanned history."
        continue
      fi
      # fail-open-ok: no merge base leaves this empty and the full-history walk below is used, which reads MORE than the range, never less.
      TAG_BASE="$(git -C "$REPO" merge-base "$TRUNK_NAME" "$TAG_TIP" 2>/dev/null || true)"
      if [ -n "$TAG_BASE" ]; then
        slh_scan_walk "$REPO" "the history tag $tname publishes" "$TAG_BASE..$TAG_TIP" || true # fail-open-ok: the refusal is recorded in SLH_REFUSED and acted on below
      else
        slh_scan_walk "$REPO" "the history tag $tname publishes" "$TAG_TIP" || true # fail-open-ok: same, recorded and decided below
      fi
      continue
      ;;
    refs/heads/*) ;;
    *)
      # F4 OF THE 2.7.0 LEG, fix round 1: a pushed ref in a namespace this hook
      # does not recognise used to be skipped in SILENCE, so on a review-ref
      # workflow (Gerrit's refs/for/<branch> is the common one) neither the
      # content scan nor the trunk audit ran and the push left at exit 0 looking
      # governed. It REPORTS now and still refuses nothing, which is the whole
      # of the fix by ruling: teaching this hook another forge's ref grammar
      # would be a spelling nobody here can exercise end to end, and an
      # unexercised spelling is the class that has cost this project two
      # reverts. The scope is documented in Known limitations with the two ways
      # through, and native support waits on a field report.
      slh_report "SLH-REF-NOT-AUDITED" "no trunk audit and no content scan ran for $rref, because this hook reads refs/heads/* and refs/tags/* only. On a review-ref workflow (for example Gerrit's refs/for/<branch>) the work reaching the remote by this ref is ungoverned by these hooks. The two ways through: push the trunk directly so the audit reads it, or require the stamped forge check on the trunk, which judges the merge a pull request would make."
      continue
      ;;
  esac
  rname="${rref#refs/heads/}"

  # HISTORY: ruling PP-09 (undated): --- half one: THE CONTENT SCAN, over EVERY pushed ref -------------------.
  case "$_roid" in
    *[!0]*) SCAN_ARGV=("$_roid..$_loid") ;;
    *)      if [[ -n "$REMOTE_ARG" && -n "$(git -C "$REPO" for-each-ref --count=1 "refs/remotes/$REMOTE_ARG" 2>/dev/null)" ]]; then
              SCAN_ARGV=("$_loid" --not "--remotes=$REMOTE_ARG")
            else
              SCAN_ARGV=("$_loid")
            fi ;;
  esac
  if git -C "$REPO" rev-parse --quiet --verify "${_loid}^{commit}" >/dev/null 2>&1; then
    slh_scan_walk "$REPO" "the history this push adds to $rname" "${SCAN_ARGV[@]}" || true # fail-open-ok: the refusal is recorded in SLH_REFUSED and decided below, so a non-zero return must not abort before every ref is read
    # HISTORY: ruling PP-10 (undated): --- half one-b: THE APPROVAL CHECK, over the same refs and the same range.
    slh_attest_walk "$REPO" "the history this push adds to $rname" "$_loid" "${SCAN_ARGV[@]}" || true # fail-open-ok: the refusal is recorded in SLH_REFUSED and decided below, so a non-zero return must not abort before every ref is read
  else
    slh_refuse "SLH-SCAN-UNRESOLVED-TIP" "the tip this push would put on $rname ($_loid) does not resolve to a commit here, so what it publishes cannot be read. Refusing rather than reporting a scan that did not run."
  fi

  # HISTORY: ruling PP-11 (undated): --- half two: THE TRUNK AUDIT, over trunk refs only ---------------------.
  # From a checkout without the file, a tip's own configuration names a trunk too (F7, above).
  _own_trunk=""
  if [[ -n "$CFG_FROM" && "$_loid" != "$CFG_FROM" ]] && git -C "$REPO" show "$_loid:.claude/sdd.json" > "$CFG_TMPD/tip.json" 2>/dev/null; then
    _own_trunk="$(SLH_SDD="$CFG_TMPD/tip.json" slh_trunk "$REPO" 2>/dev/null)" || _own_trunk="" # fail-open-ok: a tip whose trunk cannot be read adds no trunk; the first governed tip's reading above still decides
  fi
  if [[ "$rname" == "$TRUNK_NAME" || ( -n "$_own_trunk" && "$rname" == "$_own_trunk" ) || ( -n "$REMOTE_TRUNK" && "$rname" == "$REMOTE_TRUNK" ) || "$REMOTE_EMPTY" -eq 1 ]]; then
    PUSH_REFS="$PUSH_REFS $_loid"
  fi
done <<< "$PUSH_LINES"

# HISTORY: ruling PP-12 (undated): slh_refuse RECORDS a refusal, it does not exit, so the scan above is only a guarantee if this reads it.
if [[ "${SLH_REFUSED:-0}" -ne 0 ]]; then
  # The content paragraph is said only when a content scan refused (spec 0164):
  # a scan that could not run, or a check that is not about the content, is told
  # to fix what the lines above name, not the content.
  if [[ "${SLH_SCAN_CONTENT_REFUSED:-0}" -ne 0 ]]; then
    printf '\nsetlist pre-push: the history being pushed carries content the commit-time\n' >&2
    printf 'scans never saw (cherry-pick, rebase and am create commits without firing\n' >&2
    printf 'pre-commit). Fix the content. Skipping the trunk audit does NOT skip this scan.\n' >&2
  else
    printf '\nsetlist pre-push: refusing this push. Fix what the lines above name; skipping\n' >&2
    printf 'the trunk audit does NOT skip these checks.\n' >&2
  fi
  exit 1
fi

# THE AUDIT ARM, WHICH IS WHAT SETLIST_SKIP_TRUNK_AUDIT=1 SKIPS (KL2). The scan
# above has already run and already had its say; skipping the audit here rather
# than at the top of the file is the whole of the narrowing.
if [[ "$SKIP_AUDIT" -eq 1 ]]; then
  # fail-open-ok: the DOCUMENTED escape hatch for the AUDIT ONLY, announced on
  # stderr at the top of this run. The content scan ran and did not refuse.
  exit 0
fi

RC=0
if [[ -n "$PUSH_REFS" ]]; then
  for _oid in $PUSH_REFS; do
    _cfg="$CFG_FROM"
    if [[ -n "$CFG_FROM" ]]; then
      if git -C "$REPO" cat-file -e "$_oid:.claude/sdd.json" 2>/dev/null; then
        _cfg="$_oid"
      else
        slh_report "SLH-REF-NOT-AUDITED" "no trunk audit ran for the pushed trunk tip $_oid: it carries no .claude/sdd.json of its own and neither does this checkout, so that work is ungoverned by these hooks (Known limitations, checkout-switch); it is not audited under another pushed branch's configuration. Push from a checkout that carries the file, and require the forge check on the trunk."
        continue
      fi
    fi
    bash "$AUDIT" "$REPO" --until "$_oid" ${_cfg:+--config-from "$_cfg"} || RC=$?
    [[ "$RC" -eq 0 ]] || break
  done
elif [[ "$REMOTE_UNREACHABLE" -eq 1 ]]; then
  # HISTORY: ruling PP-13 (plugin 2.6.0): The remote could not be reached, so which of its refs is the trunk is unknown, and auditing the local trunk instead would report on a ref this push may not touch.
  printf 'setlist pre-push [SLH-REMOTE-UNRESOLVED]: cannot reach %s to ask which branch\n' "${1:-the remote}" >&2
  printf 'is its trunk, so this push cannot be audited. A check that cannot run has not\n' >&2
  printf 'passed. Fix connectivity.\n' >&2
  RC=1
else
  # HISTORY: ruling PP-14 (undated): No line named the trunk, or stdin was empty because a caller invoked this hook by hand.
  bash "$AUDIT" "$REPO" ${CFG_FROM:+--config-from "$CFG_FROM"} || RC=$?
fi
if [[ "$RC" -eq 0 ]]; then
  # fail-open-ok: the audit ran and reported a clean trunk. This is the allow.
  exit 0
fi
if [[ "$RC" -eq 2 ]]; then
  printf '\nsetlist pre-push: the audit could not run (see above). Refusing the push.\n' >&2
  exit 1
fi
printf '\nsetlist pre-push: the trunk carries work that did not arrive through a\n' >&2
printf 'closed spec. Fix the history.\n' >&2
exit 1
