#!/usr/bin/env bash
# Setlist trunk audit as a git pre-push hook. STAMPED AND LIVE since edition v1.7:
# scripts/stamp.sh and scripts/refresh-instance.sh both install it to
# .githooks/pre-push and set core.hooksPath, so it runs on every push without
# anyone adopting it.
#
# This header said the opposite until 2026-08-03. It read "OPT-IN: this file is
# NOT stamped into an instance ... and nothing installs it for you", and gave
# copy instructions targeting .git/hooks/pre-push. Both halves were wrong and the
# second was actively harmful: .git/hooks is NOT cloned, which is the whole reason
# the stamp uses a tracked .githooks/ directory plus core.hooksPath, so following
# these instructions produced a hook that protects exactly one working copy and
# looks installed. A shipped file's own documentation contradicting the shipped
# stamp is this repository's signature defect; it was filed during the v1.7 gate's
# Phase 1, missed by the Phase 4 pass that edited this very layer, and found
# independently by the 1.1.0 hostile leg.
#
# Why opt-in, and why a git hook rather than a Claude Code hook. The three
# PreToolUse gates decide by parsing a shell command before it runs, and a
# shell command can compute its own arguments, so no parser can be correct
# about what a command will do. This asks a question that needs no parsing:
# does the trunk's HISTORY show every piece of feature code arriving through a
# closed spec? It therefore catches what the parsers miss by construction,
# including work that reached the trunk through a renamed branch, a cherry-pick,
# a tag, or your forge's merge button, which no local Claude Code hook can see
# at all. It does NOT see through merge topology built to hide the work: the
# chained-merge and octopus checks were removed on 2026-08-07 because neither
# could tell a crafted merge apart from `git pull` on a shared trunk, and both
# routes are named in Known limitations.
#
# It runs at push, which is the last moment the history is still private.
#
# This paragraph used to say the hook was "the OPT-IN half of the mechanism"
# and that making it part of the protocol "waits for the v1.7 cut (backlog item
# 28)". The 2026-08-03 correction above fixed the header and left this standing
# four lines below it, so the file contradicted itself in the same comment
# block; the 1.1.0 hostile leg filed the header half and this half survived it.
# v1.7 IS the cut. Item 28 landed, this hook is stamped by default, and the
# enforcement boundary is described in the edition text.
#
# To bypass once, for a deliberate exception you are willing to own:
#   SETLIST_SKIP_TRUNK_AUDIT=1 git push ...

set -u

if [[ "${SETLIST_SKIP_TRUNK_AUDIT:-}" == "1" ]]; then
  printf 'setlist: trunk audit skipped by SETLIST_SKIP_TRUNK_AUDIT=1\n' >&2
  # fail-open-ok: the DOCUMENTED escape hatch, announced on stderr so the bypass
  # is never silent.
  exit 0
fi

REPO="$(git rev-parse --show-toplevel 2>/dev/null || printf '.')"
[[ -f "$REPO/.claude/sdd.json" ]] || exit 0   # not a framework instance

# The audit ships with the plugin. Resolve it from the plugin root when the
# environment names one, else from a copy the project vendored next to its
# hooks. If neither is present the hook says so and REFUSES, rather than
# passing silently: a pre-push check that cannot find its own tool and exits 0
# is the fail-open class this whole mechanism exists to remove.
AUDIT=""
for cand in \
  "${CLAUDE_PLUGIN_ROOT:-}/scripts/trunk-audit.sh" \
  "$REPO/.claude/hooks/trunk-audit.sh" ; do
  [[ -n "$cand" && -f "$cand" ]] && { AUDIT="$cand"; break; }
done
if [[ -z "$AUDIT" ]]; then
  printf 'setlist pre-push: cannot find trunk-audit.sh.\n' >&2
  printf '  Set CLAUDE_PLUGIN_ROOT, or copy the script to .claude/hooks/trunk-audit.sh.\n' >&2
  printf '  Refusing rather than passing: a check that cannot run has not passed.\n' >&2
  exit 1
fi

# THE STATUS IS CAPTURED FROM THE AUDIT, NOT FROM THE IF-COMPOUND.
#
# This was `if bash "$AUDIT" "$REPO"; then exit 0; fi` followed by `RC=$?`, and
# the status of an if-compound whose condition failed with no else branch is 0,
# not the condition's status. RC was therefore always 0, the RC==2 test below was
# dead code, and an audit that could not run AT ALL was reported to the operator
# as a dirty trunk: a claim about their history that nothing had checked
# (v1.7 gate, hostile leg F11). Both branches refuse, so this was never a bypass,
# only a confidently wrong diagnostic.
# WHAT IS ACTUALLY BEING PUSHED, rather than what the local trunk happens to be
# (1.1.0 leg, fourth run, F17).
#
# This hook ignored its stdin entirely and audited the LOCAL trunk. git hands
# pre-push one line per ref being pushed:
#
#     <local ref> <local oid> <remote ref> <remote oid>
#
# so a REFSPEC that pushes some other local ref ONTO the remote trunk was never
# examined: `git push origin spec/0001-thing:refs/heads/main` landed unclosed
# feature code on the remote trunk while this hook audited local main, printed
# "0 violations" and exited 0. The trunk audit is the documented backstop for
# every sideways route, and the sideways route went around the backstop.
#
# So the refspec lines are read and every LOCAL OID that would become the remote
# trunk is audited. The local trunk is still audited when it is among them, which
# is the ordinary `git push` case and the only one this hook used to handle.
#
# Reading stdin makes this hook consume it, which is correct: git expects
# pre-push to read those lines, and nothing downstream of here needs them.
# THE ONE REDUCER, and this hook had none (1.1.0 final leg, F2/F3/F4, three
# finders on one cause).
#
# This block used to read .trunk with its own jq and compare it RAW. The shared
# library REDUCES the recorded value: a ref path becomes the local branch it
# names, a remote-tracking spelling becomes the branch it tracks, an
# unresolvable one is REFUSED, and a case variant becomes git's stored spelling.
# So for a trunk recorded as `refs/remotes/origin/main`, which is exactly what
# the upgrade skill's own detection command returns, the refspec audit added
# earlier the same day was DEAD CODE: the comparison below could never match,
# and `git push origin spec/0001-x:refs/heads/main` put unreviewed work on the
# remote trunk at rc=0 while the audit reported the local one clean.
#
# That is the third time in this cycle that one side of a comparison was
# normalised and the other was not, and the second written while fixing the
# previous instance. The repair is therefore the CLASS and not the case: every
# reader of the trunk identity binds to this reducer, and the suite asserts they
# agree BY OUTPUT over a corpus of ref spellings rather than by looking alike.
LIB=""
for cand in "$(dirname "$0")/setlist-hook-lib.sh" "$REPO/.githooks/setlist-hook-lib.sh"; do
  [[ -f "$cand" ]] && { LIB="$cand"; break; }
done
if [[ -z "$LIB" ]]; then
  printf 'setlist pre-push: cannot find setlist-hook-lib.sh beside this hook.\n' >&2
  printf '  Refusing rather than reading the trunk a second way: two readers of one value\n' >&2
  printf '  is the defect this hook was repaired for.\n' >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$LIB"

# THE TOOLCHAIN PROBE, WHICH THIS HOOK DID NOT RUN (v1.7 claims audit, R2-3).
#
# pre-commit and pre-merge-commit both call this before reading anything, and
# refuse SLH-NO-TOOLCHAIN when awk, sed, tr or grep are present but broken.
# pre-push did not, and its content scan is pure grep: a grep that exits
# non-zero with no output is indistinguishable from "nothing matched", so the
# scan reported clean and the push succeeded. Measured on the shipped bytes
# before this line existed: with a grep that exits 1, the same content is
# REFUSED at commit time with SLH-NO-TOOLCHAIN and PUSHED at exit 0, with the
# secret landing on the remote.
#
# That is the fail-open the library banner exists to say was removed, in the one
# layer the release calls its guarantee. It is fixed here rather than documented
# because a scan that cannot run must refuse, which is the same rule the missing
# trunk-audit.sh refusal in this file already follows.
#
# This changes NO coverage. The scan still reads exactly what it read; it stops
# reporting clean when it is not in a position to report anything.
slh_require_toolchain || {
  printf '\nsetlist pre-push: the push-time scan cannot run (see above).\n' >&2
  printf 'Refusing the push rather than reporting a clean scan it did not perform.\n' >&2
  exit 1
}

TRUNK_NAME="$(slh_trunk "$REPO")" || {
  printf '\nsetlist pre-push: the recorded trunk could not be reduced to a local branch (see above).\n' >&2
  printf 'Refusing the push: a hook that cannot establish the trunk cannot audit it.\n' >&2
  exit 1
}
[[ -n "$TRUNK_NAME" ]] || { printf 'setlist pre-push: the reduced trunk is empty; refusing.\n' >&2; exit 1; }

# THE REMOTE'S TRUNK MAY NOT SHARE THE LOCAL NAME (F11). Matching only the local
# name meant `refs/heads/spec/0004-bad -> refs/heads/master` was never audited.
# Widening to "audit every pushed ref" would refuse the ordinary push of a spec
# branch to its own remote name, which is the false-denial direction this repo
# treats as the more dangerous one, so the remote's own default branch is
# resolved and treated as a trunk ref alongside the local name.
# AND IT MUST NOT BE READ FROM A CACHED CONVENIENCE REF (F7, 2026-08-07 leg).
#
# This resolved the remote trunk ONLY through refs/remotes/$1/HEAD. git passes
# $1 as the literal URL when a push names a URL, so no such ref exists, and
# `git remote set-head origin -d` removes it for the by-name spelling. Either
# way REMOTE_TRUNK went empty, no pushed ref matched a trunk name, PUSH_REFS
# stayed empty, and control fell through to the branch that audits the LOCAL
# trunk. Measured: unclosed feature code reached the REMOTE trunk at rc=0 while
# this hook printed "audited 0 commits on main ... 0 violations", which is a
# true statement about a ref the push never touched.
#
# So the remote is ASKED, rather than the local cache consulted. ls-remote
# resolves the default branch for a URL and for a remote name alike, which is
# the point: the two spellings stop diverging.
#
# The unresolvable case is decided by WHY it is unresolvable, because the three
# reasons want different answers:
#   unreachable (ls-remote fails)  -> refuse: the trunk cannot be identified,
#                                     so nothing about this push is auditable
#   reachable, has refs, no HEAD   -> the remote has no default branch, so no
#     symref                          pushed ref can BE the remote trunk and
#                                     the local-name test is already complete
#   reachable, NO refs yet (empty) -> every pushed refs/heads/* ref is about to
#                                     BECOME a candidate remote trunk (git hosts
#                                     adopt the first pushed branch as the
#                                     default), so audit them all as trunk. This
#                                     is F1 of the plugin-2.0.0 hostile leg: a
#                                     differently-named branch pushed first to an
#                                     empty remote used to fall through to
#                                     auditing LOCAL main and ALLOW unclosed
#                                     feature code onto the new remote default,
#                                     the exact fail-open (audit a ref the push
#                                     never touched) this whole block exists to
#                                     close, reintroduced for the empty sub-case.
# Conflating them would either break offline work or reinstate a hole.
REMOTE_TRUNK=""
REMOTE_UNREACHABLE=0
REMOTE_EMPTY=0
if [[ -n "${1:-}" ]]; then
  REMOTE_TRUNK="$(git -C "$REPO" symbolic-ref --quiet --short "refs/remotes/$1/HEAD" 2>/dev/null || true)" # fail-open-ok: the cache is a fast path only; the live query below is what decides when it is empty
  REMOTE_TRUNK="${REMOTE_TRUNK#$1/}"
  if [[ -z "$REMOTE_TRUNK" ]]; then
    if SYMREF_OUT="$(git -C "$REPO" ls-remote --symref "$1" HEAD 2>/dev/null)"; then
      REMOTE_TRUNK="$(printf '%s\n' "$SYMREF_OUT" | awk '$1 == "ref:" { sub(/^refs\/heads\//, "", $2); print $2; exit }')"
      # No HEAD symref AND no branch refs at all is an EMPTY remote: this push
      # creates its first branch(es). `ls-remote --heads` printing nothing
      # identifies it; a remote that HAS refs but no HEAD is not empty and keeps
      # the "no pushed ref can be the trunk" reading above. A transient failure
      # of this second query yields empty output too, which sets REMOTE_EMPTY and
      # audits every pushed ref as trunk: fail-CLOSED (over-strict), never open.
      if [[ -z "$REMOTE_TRUNK" && -z "$(git -C "$REPO" ls-remote --heads "$1" 2>/dev/null)" ]]; then
        REMOTE_EMPTY=1
      fi
    else
      REMOTE_UNREACHABLE=1
    fi
  fi
fi

PUSH_REFS=""
# ===========================================================================
# TWO CHECKS, TWO SCOPES, AND THEY ARE NOT THE SAME SCOPE (F2, verdict leg).
#
# This loop used to apply the trunk-name filter FIRST and then do both jobs
# inside it, so the content scan inherited the audit's scope. The audit's scope
# is right: it reads trunk history and only the trunk has that rule. The scan's
# scope was wrong, and wrong in the direction that publishes: the ordinary push
# of a spec branch, which is what every contributor does every day, skipped the
# scan entirely and put cherry-picked, rebased and am-applied secrets on the
# remote. The hook RAN, printed its audit, and scanned nothing.
#
# That also falsified what this release had already written down. Fix round 2's
# Known-limitations bullet said a local history could carry an unscanned secret
# and a pushed one could not. The assertion behind it was real and exercised the
# trunk path, so the claim outran the mechanism by exactly one ref name.
#
# So the halves are separated rather than reordered, because "reorder these two
# statements" is a patch and "these two checks answer different questions about
# different sets of refs" is the shape. Each now states its own scope where it
# runs, and neither can inherit the other's by being written underneath it.
# ===========================================================================
while read -r _lref _loid rref _roid; do
  [[ -n "${rref:-}" ]] || continue
  case "$rref" in
    refs/heads/*) ;;
    *) continue ;;
  esac
  rname="${rref#refs/heads/}"

  # A deletion pushes the all-zero local oid and removes the branch. No history
  # is arriving, so there is nothing to scan and nothing to audit.
  case "$_loid" in *[!0]*) ;; *) continue ;; esac

  # --- half one: THE CONTENT SCAN, over EVERY pushed ref -------------------
  #
  # Scope: every branch this push would create or advance on the remote. Git
  # fires no hook for cherry-pick, for rebase's intermediate commits, or for the
  # apply step of `git am`, so those commits reach a remote unscanned unless
  # they are read here. Nothing about that reasoning is specific to the trunk:
  # a secret published on a spec branch is published.
  #
  # The range is what this push ADDS. An existing remote branch gives its own
  # oid; a new branch pushes the all-zero remote oid and has no range, so the
  # merge-base with the local trunk is used, which is the set of commits the
  # branch carries that the trunk does not.
  case "$_roid" in
    *[!0]*) SCAN_RANGE="$_roid..$_loid" ;;
    *)      SCAN_BASE="$(git -C "$REPO" merge-base "$TRUNK_NAME" "$_loid" 2>/dev/null || true)" # fail-open-ok: an unresolvable base leaves the range empty and the scan is skipped, which the edition records as a documented hole
            if [ -n "$SCAN_BASE" ]; then SCAN_RANGE="$SCAN_BASE..$_loid"; else SCAN_RANGE=""; fi ;;
  esac
  if [ -n "${SCAN_RANGE:-}" ]; then
    slh_scan_added "$(git -C "$REPO" diff --unified=0 "$SCAN_RANGE" 2>/dev/null)" "the history this push adds to $rname"
  fi

  # --- half two: THE TRUNK AUDIT, over trunk refs only ---------------------
  #
  # Scope: refs that ARE the trunk, locally named or the remote's default. The
  # audit reads whether work reached the trunk through a closed spec, which is a
  # question only the trunk has. Widening it to every pushed ref would refuse
  # the ordinary push of a spec branch, which is the false-denial direction this
  # repository treats as the more dangerous one -- EXCEPT on an empty remote,
  # where there is no established default yet and every pushed ref is a
  # candidate to become it (F1). There the wider scope is correct: a feature
  # branch pushed first to an empty remote would otherwise become its unaudited
  # default. The cost is that a spec branch pushed ALONGSIDE the trunk to a
  # brand-new remote is also audited and refused; that is fail-closed, rare, and
  # escapable with SETLIST_SKIP_TRUNK_AUDIT=1, and the common bootstrap (push the
  # clean trunk, which audits clean) is unaffected.
  if [[ "$rname" == "$TRUNK_NAME" || ( -n "$REMOTE_TRUNK" && "$rname" == "$REMOTE_TRUNK" ) || "$REMOTE_EMPTY" -eq 1 ]]; then
    PUSH_REFS="$PUSH_REFS $_loid"
  fi
done

# slh_refuse RECORDS a refusal, it does not exit, so the scan above is only a
# guarantee if this reads it. Checked here rather than inside the loop so every
# pushed ref is scanned and the operator sees all the reasons at once instead of
# fixing them one push at a time.
if [[ "${SLH_REFUSED:-0}" -ne 0 ]]; then
  printf '\nsetlist pre-push: the history being pushed carries content the commit-time\n' >&2
  printf 'scans never saw (cherry-pick, rebase and am create commits without firing\n' >&2
  printf 'pre-commit). Fix the content, or push with SETLIST_SKIP_HOOKS=1 if this is a\n' >&2
  printf 'deliberate exception you are willing to own.\n' >&2
  exit 1
fi

RC=0
if [[ -n "$PUSH_REFS" ]]; then
  for _oid in $PUSH_REFS; do
    bash "$AUDIT" "$REPO" --until "$_oid" || RC=$?
    [[ "$RC" -eq 0 ]] || break
  done
elif [[ "$REMOTE_UNREACHABLE" -eq 1 ]]; then
  # The remote could not be reached, so which of its refs is the trunk is
  # unknown, and auditing the local trunk instead would report on a ref this
  # push may not touch.
  #
  # The first draft of this comment said refusing costs nothing because the push
  # would fail anyway. MEASURED, and that is wrong: git rejects a plainly
  # unreachable remote before this hook ever runs, and the cached remote HEAD is
  # consulted first, so the case that actually arrives here is narrow: no cached
  # refs/remotes/<name>/HEAD, AND a fetch url that cannot be reached, AND a push
  # url that can (`git remote set-url --push`). There the push would have
  # succeeded, so
  # this refusal is a real cost, taken deliberately because the alternative is
  # the fail-open F7 measured: unclosed code on the remote trunk under a printed
  # "0 violations". An ordinary split fetch/push setup with both urls working
  # resolves fine and never reaches here. The escape is named in the message.
  printf 'setlist pre-push [SLH-REMOTE-UNRESOLVED]: cannot reach %s to ask which branch\n' "${1:-the remote}" >&2
  printf 'is its trunk, so this push cannot be audited. A check that cannot run has not\n' >&2
  printf 'passed. Fix connectivity, or push with SETLIST_SKIP_HOOKS=1 if you are willing\n' >&2
  printf 'to own the exception.\n' >&2
  RC=1
else
  # No line named the trunk, or stdin was empty because a caller invoked this
  # hook by hand. Auditing the local trunk is the conservative reading: it is
  # what this hook has always done, and skipping the check because a refspec
  # named something else would be the fail-open this change exists to remove.
  bash "$AUDIT" "$REPO" || RC=$?
fi
if [[ "$RC" -eq 0 ]]; then
  # fail-open-ok: the audit ran and reported a clean trunk. This is the allow.
  exit 0
fi
if [[ "$RC" -eq 2 ]]; then
  printf '\nsetlist pre-push: the audit could not run (see above). Refusing the push.\n' >&2
  exit 1
fi
printf '\nsetlist pre-push: the trunk carries work that did not arrive through a\n' >&2
printf 'closed spec. Fix the history, or push with SETLIST_SKIP_TRUNK_AUDIT=1 if\n' >&2
printf 'this is a deliberate exception you are willing to own.\n' >&2
exit 1
