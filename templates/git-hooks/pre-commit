#!/usr/bin/env bash
# Setlist pre-commit hook: the CHEAP checks, over the index that is about to
# become a commit.
#
# Why a git hook rather than a Claude Code PreToolUse gate. The gates decide by
# parsing a shell command before it runs, and a shell command can compute its own
# arguments, so no parser can be correct about what a command will do. This hook
# asks git what is actually staged. For any commit that reaches this hook there
# is nothing left to spell around: the index is the index whether the commit was
# written `git commit -m x`, `{ nice -n 5 git commit -m x; }`, or `$COMMIT_CMD`.
# That is a claim about the SHELL, and it is scoped on purpose: a commit that
# never reaches this hook (--no-verify, core.hooksPath unset, the per-clone gap)
# is outside it, exactly as Known limitations records.
#
# WHAT LIVES HERE AND WHAT DOES NOT. Cheap checks only. The close verification
# can run the project's full suite, which is tolerable once at merge time and
# intolerable on every commit, so it lives in pre-merge-commit. There is exactly
# one exception and it is measured rather than assumed, below.
#
# THE SQUASH ANSWER, settled by running git rather than by reading about it.
# Measured 2026-08-01, one probe repository, every merge form:
#
#   operation                          pre-commit   pre-merge-commit
#   ordinary commit                       YES            no
#   git merge --no-ff (true merge)        no             YES
#   git merge --ff-only (fast-forward)    no             no
#   git merge --squash (stages only)      no             no
#   the commit completing a squash        YES            no
#
# Three consequences, and none of them is what the naive reading predicts:
#
#   1. A squash merge NEVER reaches pre-merge-commit. It reaches pre-commit, as
#      an ordinary-looking commit. So the close verification has to run from here
#      too, or squashing is a total bypass of it. That is why this hook has an
#      expensive branch at all.
#   2. pre-commit does NOT fire for a true merge commit. The two hooks are
#      disjoint, not nested, so neither can rely on the other having run.
#   3. A FAST-FORWARD merge fires NOTHING. No local hook sees it. That is a real
#      hole, it is documented in the edition's Known limitations, and pre-push
#      (the trunk audit, which reads history) is what covers it.
#
# A squash is recognised by $GIT_DIR/SQUASH_MSG, which `git merge --squash`
# writes and an ordinary commit does not. Verified in the same probe.
#
# To bypass once, for a deliberate exception you are willing to own:
#   SETLIST_SKIP_HOOKS=1 git commit ...
# `git commit --no-verify` also bypasses it, as it bypasses every git hook. Both
# are documented holes rather than oversights: they are deliberate acts with an
# obvious name, which is a different kind of hole from an apostrophe in a commit
# message.

set -u

if [ "${SETLIST_SKIP_HOOKS:-}" = "1" ]; then
  printf 'setlist: pre-commit skipped by SETLIST_SKIP_HOOKS=1\n' >&2
  # fail-open-ok: the DOCUMENTED escape hatch, announced on stderr.
  exit 0
fi

PROJ="$(git rev-parse --show-toplevel 2>/dev/null || printf '.')"
[ -f "$PROJ/.claude/sdd.json" ] || exit 0   # not a framework instance

# Resolve the shared library. Refusing beats passing when it cannot be found: a
# hook that silently skips its own logic is the fail-open class this mechanism
# exists to remove.
LIB=""
for cand in \
  "$(dirname "$0")/setlist-hook-lib.sh" \
  "${CLAUDE_PLUGIN_ROOT:-}/templates/git-hooks/setlist-hook-lib.sh" \
  "$PROJ/.claude/hooks/setlist-hook-lib.sh" ; do
  if [ -n "$cand" ] && [ -f "$cand" ]; then LIB="$cand"; break; fi
done
if [ -z "$LIB" ]; then
  printf 'setlist pre-commit: cannot find setlist-hook-lib.sh.\n' >&2
  printf '  Refusing rather than passing: a check that cannot run has not passed.\n' >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$LIB"

# The tools the library runs on must actually work before anything it decides can
# be trusted. A broken grep turned this hook into a silent pass (v1.7 gate, F2).
slh_require_toolchain || exit 1

TRUNK="$(slh_trunk "$PROJ")" || exit 1

STAGED="$(slh_staged_files "$PROJ")"
# fail-open-ok: an empty index is nothing to judge. Note the direction: only an
# EMPTY staged list short-circuits, and it short-circuits because a commit with
# no content carries no work anywhere.
[ -n "$STAGED" ] || exit 0

# ---------------------------------------------------------------------------
# Cheap checks 1 and 2: no em-dash and no secret-shaped string in newly added
# content. The RULE lives in setlist-hook-lib.sh and is called from here, from
# pre-merge-commit and from pre-push, because binding it to one operation is
# what let cherry-pick, rebase, am and merge carry unscanned bytes to the trunk
# (F1 of the 2026-08-05 leg). See the library for what commit-time layers
# cannot cover and which layer catches it instead.
# ---------------------------------------------------------------------------
# THE DIFF IS A RENDERING THE REPOSITORY'S OWN CONFIGURATION CONTROLS, and the
# scan reads the rendering (RC2-2026, the 2.4.0 review's F2; fixed 2026-09-02,
# spec 0129). Measured on the shipped bytes: `color.ui=always` colours every
# `+` line into the pipe and the added-line filter matched nothing, so a
# live-shaped secret committed clean at exit 0 with nothing printed; a
# `diff.external` driver and a textconv driver hide content the same way. So
# the flags here ignore configuration: --no-color, --no-ext-diff, --no-textconv.
# The prefixes stay pinned for the header strip; prefix SETTINGS were measured
# and blind nothing, because the filter is positional.
#
# AND GIT'S OWN STATUS IS READ, because a diff that arrives through a command
# substitution loses it: a git that ran and died rendered nothing, and nothing
# read as clean. A scan that could not run has not passed.
if __DIFF="$(git -C "$PROJ" diff --cached --unified=0 --no-color --no-ext-diff --no-textconv --src-prefix=a/ --dst-prefix=b/ 2>/dev/null)"; then
  slh_scan_added "$PROJ" "$__DIFF" "staged content"
else
  slh_refuse "SLH-SCAN-FILTER-FAILED" "git could not render the staged diff, so the scan of staged content read nothing and has judged nothing. A scan that could not run has not passed. Run 'git diff --cached' here to see the failure (a configuration value git cannot parse, or a diff driver that fails, looks like this), or commit with SETLIST_SKIP_HOOKS=1 if this is an exception you are willing to own."
fi

# ---------------------------------------------------------------------------
# Cheap check 3: a staged spec lifecycle transition stages specs/STATUS.md too.
# The vocabulary is the canonical enumeration from the edition (Part 5); the
# suite asserts this list matches it and matches commit-gate.sh's.
#
# THE READING ITSELF LIVES IN THE LIBRARY (V19-F2). This hook used to grep the
# raw staged diff here, with no fence handling and no indent allowance, and it
# was the one reader of four that did: a quoted template refused an honest
# commit and an indented heading was invisible. The enumeration stays here,
# because the suite pins it against the edition and commit-gate.sh from this
# file; the QUESTION moved to slh_lifecycle_added, beside the readers it now
# agrees with.
# ---------------------------------------------------------------------------
SLH_LIFECYCLE_STATES='DRAFT QUEUED ACTIVE REVISED BUILT PARKED CLOSED'
STATES_RE="$(printf '%s' "$SLH_LIFECYCLE_STATES" | tr ' ' '|')"
# The exclusions are the two framework-owned files: STATUS.md is the inventory
# itself, TEMPLATE.md is a template by definition.
# Collected into an ARRAY rather than word-split out of a string: a spec path
# containing a space would otherwise arrive as two paths, both unreadable, and
# the detector would go quiet on exactly the file it was asked about. The
# pathspec this replaced had no such problem, so preserving it is a fix keeping
# its own promise rather than an improvement.
# fail-open-ok: a grep that filters everything out means this commit stages no
# spec file, so there is no lifecycle transition to pair with an inventory row.
if slh_record_present "$PROJ" ""; then
  # THE RECORD, OR THE PAGE (RP1, edition v1.12). In a structured instance the
  # lifecycle-flip detection is A STAGED CHANGE TO .claude/status.json, not a
  # parse of the spec's markdown: the record is the machine inventory, so the
  # record moving IS the lifecycle fact, and the frozen fence reader stops
  # being load-bearing here. A staged MODIFICATION (never the addition: the
  # adoption commit that creates the record is an opt-in, not a flip) demands
  # the human page in the same commit, which is what checkpoint writes anyway.
  if git -C "$PROJ" diff --cached --name-only --diff-filter=M 2>/dev/null | grep -qx '.claude/status.json'; then
    if ! printf '%s\n' "$STAGED" | grep -qx 'specs/STATUS.md'; then
      slh_refuse "SLH-STATUS-MISSING" "this commit changes the status record (.claude/status.json) but does not stage specs/STATUS.md; /setlist:checkpoint writes the record and the human inventory page in the same commit, so a record change arriving alone is a hand edit or half a checkpoint."
    fi
  fi
  # A STAGED RECORD MUST PARSE, at the earliest layer that can refuse it. This
  # is where a hand edit outside checkpoint gets caught before it is history:
  # present-and-malformed refuses, never a pass, never a fallback to the page.
  if printf '%s\n' "$STAGED" | grep -qx '.claude/status.json'; then
    __REC_STAGED="$(slh_record_show "$PROJ" "")"
    if [ "$(slh_record_verdict "$__REC_STAGED")" != "ok" ]; then
      slh_refuse "SLH-RECORD-MALFORMED" "the staged .claude/status.json is not a well-formed status record (Part 3 of the edition: setlist_status 1; specs.<num> with a lowercase lifecycle token, qa_pass_1 exactly ok, diagram exactly updated or no-impact; chores.<id> open or done with files as an array). Only /setlist:checkpoint writes this file; fix the staged copy rather than committing a record no gate can read, because every gate that reads it refuses a malformed record outright."
    fi
  fi
else
  # fail-open-ok: a grep that filters everything out means this commit stages no
  # spec file, so there is no lifecycle transition to pair with an inventory row.
  SPEC_LIST="$(printf '%s\n' "$STAGED" | grep -E '^specs/.*\.md$' | grep -vx 'specs/STATUS.md' | grep -vx 'specs/TEMPLATE.md' || true)"
  SPEC_PATHS=()
  while IFS= read -r __sp; do
    [ -n "$__sp" ] || continue
    SPEC_PATHS+=("$__sp")
  done <<EOF
$SPEC_LIST
EOF
  if [ "${#SPEC_PATHS[@]}" -gt 0 ] && slh_lifecycle_added "$PROJ" "$STATES_RE" "${SPEC_PATHS[@]}"; then
    if ! printf '%s\n' "$STAGED" | grep -qx 'specs/STATUS.md'; then
      slh_refuse "SLH-STATUS-MISSING" "this commit changes a spec lifecycle state but does not stage specs/STATUS.md; update the inventory row in the same commit."
    fi
  fi
fi

# ---------------------------------------------------------------------------
# Cheap check 4: the approval attestation (KL3). THE PRIMARY REFUSAL.
#
# This is the first hook that sees a headless session's output, and it fires
# for the ORDINARY COMMIT, which is what a headless build produces. When the
# instance declares attestation required, a commit carrying role-path content
# while a spec is ACTIVE must be covered by a valid attestation over that
# spec's CURRENT bytes. A spec that drifted after approval fails here, because
# the attestation covers the approved hash and the current bytes hash to
# something else.
#
# IT DOES NOT PREVENT THE UNAPPROVED BUILD FROM HAPPENING, and saying so here
# rather than in a caveat is the point: the only layer present when a file is
# written is the session layer, and that layer has been advisory in mechanism
# since 2026-08-04. This prevents the result becoming a commit; pre-push
# prevents it being shared.
#
# The predicate lives in the library because pre-push and the close ask the
# same question, and one reader is the rule this file already follows for the
# scans and the lifecycle detector.
# ---------------------------------------------------------------------------
ATTEST_ROLES="$(slh_role_paths "$PROJ")" || exit 1
ATTEST_CODE=0
if [ -n "$ATTEST_ROLES" ]; then
  while IFS= read -r __rp; do
    [ -n "$__rp" ] || continue
    if printf '%s\n' "$STAGED" | grep -qE "^$__rp/"; then ATTEST_CODE=1; fi
  done <<EOF
$ATTEST_ROLES
EOF
fi
if [ "$ATTEST_CODE" = "1" ]; then
  # THE ACTIVE SET COMES FROM THE RECORD in a structured instance (RP1), from
  # the page otherwise; slh_active_specs owns that switch and refuses a
  # malformed record itself. THE STATUS IS CARRIED ACROSS THE SUBSHELL: the
  # helper's slh_refuse ran in a command-substitution child, so the refusal it
  # recorded there died with that process and only the return code survives.
  # Re-recording it here is what makes the decision at the bottom see it.
  if ! __ACTIVE_SPECS="$(slh_active_specs "$PROJ" "")"; then
    SLH_REFUSED=1
    __ACTIVE_SPECS=""
  fi
  for __num in $__ACTIVE_SPECS; do
    __sf="$(slh_spec_path_for "$PROJ" "$__num")"
    # A row that names no readable spec file is the close gate's
    # SLH-CLOSES-NO-SPEC-FILE question, not this one; it is left to the layer
    # that owns it rather than answered twice with two different codes.
    [ -n "$__sf" ] || continue
    # fail-open-ok: the refusal is recorded in SLH_REFUSED and decided below,
    # so a non-zero return must not abort before every ACTIVE spec is checked.
    slh_attest_require "$PROJ" "$__sf" "staged content" || true
  done
fi

# ---------------------------------------------------------------------------
# The expensive branch: a commit that LANDS A MERGE on the trunk. Two spellings
# reach here, and the second was found by the oracle rather than reasoned out.
#
#   SQUASH_MSG  a `git merge --squash` being completed. git fires no
#               pre-merge-commit for a squash at all, so without this branch
#               squashing is a total bypass of the close verification.
#
#   MERGE_HEAD  a merge that is staged but not yet committed, being completed by
#               a plain `git commit`. This is the ordinary state git leaves
#               behind when pre-merge-commit REFUSES: it prints "Not committing
#               merge; use 'git commit' to complete the merge", and that commit
#               fires pre-commit, not pre-merge-commit. So refusing in
#               pre-merge-commit and stopping there would have left the operator
#               one documented, git-suggested command away from landing exactly
#               the merge that was just refused.
#
# The oracle caught that: the completing commit was blocked in the probe only
# because SLH-STATUS-MISSING happened to fire on unrelated grounds, which is a
# pass nobody earned. Same reason a conflicted merge resolution reaches here.
# ---------------------------------------------------------------------------
GITDIR="$(git -C "$PROJ" rev-parse --absolute-git-dir 2>/dev/null || printf '')"
LANDING=""
if [ -n "$GITDIR" ]; then
  [ -f "$GITDIR/SQUASH_MSG" ] && LANDING="squash merge"
  [ -f "$GITDIR/MERGE_HEAD" ] && LANDING="merge"
fi
if [ -n "$LANDING" ] && slh_on_trunk "$PROJ" "$TRUNK"; then
  printf 'setlist pre-commit: this commit completes a %s onto %s, so the close\n' "$LANDING" "$TRUNK" >&2
  printf '  verification runs here (git fires no pre-merge-commit for this path).\n' >&2
  # A squash landing produces a SINGLE-PARENT commit, so the ownership
  # question (design 8.2) applies here exactly as it does at the audit's
  # NPAR<2 arm; a stalled true merge keeps the merge arm's provenance
  # question instead.
  SLH_CLOSE_SINGLE_PARENT=0
  # shellcheck disable=SC2034  # read by slh_verify_close in the sourced library, which is the contract its header comment states
  [ "$LANDING" = "squash merge" ] && SLH_CLOSE_SINGLE_PARENT=1
  # fail-open-ok: both refusals are recorded in SLH_REFUSED and decided below, so
  # a non-zero return must not abort before every check has had its say.
  slh_verify_close "$PROJ" "$TRUNK" "this $LANDING" || true
  # fail-open-ok: same, the refusal is recorded and acted on below.
  slh_run_gate_command "$PROJ" || true
fi

if [ "$SLH_REFUSED" != "0" ]; then
  printf '\nsetlist pre-commit: refusing this commit. Fix the above, or commit with\n' >&2
  printf 'SETLIST_SKIP_HOOKS=1 if this is a deliberate exception you are willing to own.\n' >&2
  exit 1
fi
# fail-open-ok: reached only with SLH_REFUSED at 0, meaning every check ran and
# none refused. This is the allow this hook exists to reach on compliant work.
exit 0
